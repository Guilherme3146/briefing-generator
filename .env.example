# Inteligencia artificial (opcional) — "Separar em alteracoes" na etapa Pedido.
#
# Cole o token do Gemini em GEMINI_API_KEY (gratis em https://aistudio.google.com/apikey)
# e reinicie o servidor: o painel de IA aparece dentro do Pedido. Sem token, ele fica
# oculto e o fluxo manual funciona igual.
#
# IA_ATIVA=false esconde a IA mesmo com o token preenchido.

# Escolha UM provedor para o modo "servidor".

# Gemini — tem faixa gratuita. Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Padrao: gemini-flash-latest (alias sempre atual). Nomes fixos como
# gemini-2.5-flash foram aposentados para contas novas.
# GEMINI_MODEL=gemini-flash-latest

# Anthropic — pago por uso.
ANTHROPIC_API_KEY=

# Com as duas chaves preenchidas a Anthropic ganha; force o Gemini assim:
# IA_PROVEDOR=gemini
# Sem NENHUMA chave, IA_PROVEDOR vira so a dica de provedor no formulario do
# modo "proprio" (qual aba vem pre-selecionada para o visitante colar a dele).

# Desliga a IA inteira, mesmo sem chave nenhuma (esconde a aba e o formulario
# de "cole sua chave" do modo "proprio" tambem).
# IA_ATIVA=false

# Opcionais — os padroes ja sao os recomendados.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium
# MAX_CARACTERES_PEDIDO=60000

# PORT=3001
# TEMPLATE_PATH=./templates/briefing-modelo.xlsx

# Modelos usados quando o principal esta sobrecarregado (503), separados por virgula.
# GEMINI_MODELO_RESERVA=gemini-flash-lite-latest
# Raciocinio interno do Gemini: minimal | low | medium | high. Menor = mais rapido. Padrao: low.
# GEMINI_RACIOCINIO=low
