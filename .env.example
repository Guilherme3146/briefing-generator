# Fase 2 — sugestao por IA.
# Sem nenhuma chave o app roda normal no modo Fase 1: a rota /api/sugerir
# responde 503 e o botao some da tela. Nada mais muda.
#
# Escolha UM provedor.

# Gemini — tem faixa gratuita. Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Padrao: gemini-flash-latest (alias sempre atual). Nomes fixos como
# gemini-2.5-flash foram aposentados para contas novas.
# GEMINI_MODEL=gemini-flash-latest

# Anthropic — pago por uso.
ANTHROPIC_API_KEY=

# Com as duas chaves preenchidas a Anthropic ganha; force o Gemini assim:
# IA_PROVEDOR=gemini

# Desliga a IA mesmo com a chave presente (util para demonstrar a Fase 1).
# IA_ATIVA=false

# Opcionais — os padroes ja sao os recomendados.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium
# MAX_CARACTERES_PEDIDO=60000

# PORT=3001
# TEMPLATE_PATH=./templates/briefing-modelo.xlsx
